<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <!--
    Compile the locator source directly instead of referencing sw-addin.csproj, which pulls
    in SolidWorks COM interop assemblies that aren't available off a SOLIDWORKS dev machine.
    LeoDesktopAppLocator has no SolidWorks dependency, so linking the single file keeps these
    unit tests buildable and runnable anywhere (CI, plain `dotnet test`).
  -->
  <ItemGroup>
    <Compile Include="..\..\SwAddin\sw-addin\LeoDesktopAppLocator.cs" Link="LeoDesktopAppLocator.cs" />
  </ItemGroup>

</Project>
